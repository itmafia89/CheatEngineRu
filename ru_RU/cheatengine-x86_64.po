msgstr "Не сохранять временные файлы сканирования в папке Temp Windows"

#: tformsettings.cbdpiaware.caption
msgid "DPI Aware (Requires a restart)"
msgstr "Поддержка масштабирования DPI (требуется перезапуск)"

#: tformsettings.cbfastscan.caption
msgid "Fast scan on by default"
msgstr "Включать быстрое сканирование по умолчанию"

#: tformsettings.cbgdbwritecode.caption
msgid "Use GDB to write code"
msgstr "Использовать GDB для записи кода"

